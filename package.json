{
  "name": "fastmd-explorer",
  "version": "1.8.0",
  "description": "Lightweight Markdown file explorer and previewer",
  "type": "module",
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "bin": {
    "fastmd-explorer": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "start": "node src/cli.js",
    "dev": "node --watch src/cli.js",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:exe": "pkg src/_bundle.cjs --targets node22-win-x64 --output dist/fastmd-explorer.exe",
    "build:patch": "node scripts/patch-subsystem.mjs dist/fastmd-explorer.exe",
    "build": "pnpm run build:bundle && pnpm run build:exe && pnpm run build:patch"
  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "dompurify": "^3.4.16",
    "express": "^4.22.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.17.0",
    "marked": "^12.0.2",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^10.9.8",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2"
  }
}
